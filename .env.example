# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase → Project Settings → API Keys → secret (só no servidor, nunca NEXT_PUBLIC)
SUPABASE_SECRET_KEY=sb_secret_...

# Correção de questões discursivas (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Opcional — ajuste depois de medir a qualidade da correção (docs/PLANEJAMENTO.md, seção 6.3)
IA_MODELO=claude-opus-5-5
IA_EFFORT=low
IA_COTA_MENSAL=60
# Geração de questões a partir de material (roda em lote, 50% mais barato)
IA_MODELO_GERACAO=claude-opus-5-5
IA_EFFORT_GERACAO=medium
# Chat de dúvidas: modelo e perguntas por dia para cada aluno com a IA ativa
IA_MODELO_CHAT=claude-opus-5-5
IA_CHAT_LIMITE_DIARIO=10

# Pagamentos (Asaas → Integrações → Chaves de API). ASAAS_AMBIENTE=producao para cobrar de verdade.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Token que você define ao cadastrar o webhook no Asaas (URL: https://SEU-SITE/api/asaas/webhook)
ASAAS_WEBHOOK_TOKEN=
# Endereço público do site (usado nos links de volta do checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preços dos planos: src/lib/planos.ts. ASAAS_API_URL só para testes automatizados
# (aponta para uma API falsa); em produção deixe vazio.

# Certificado (quem assina e o nome da plataforma no PDF)
CERTIFICADO_PLATAFORMA=OdontoLab
CERTIFICADO_RESPONSAVEL=Coordenação pedagógica
CERTIFICADO_RESPONSAVEL_CARGO=
