# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase → Project Settings → API Keys → secret (só no servidor, nunca NEXT_PUBLIC)
SUPABASE_SECRET_KEY=sb_secret_...

# IA: provedores (só os que tiverem chave são usados). Use a conta PAGA do
# Gemini: na gratuita o Google usa o conteúdo para treinar modelos.
# aistudio.google.com
GEMINI_API_KEY=
# console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelos de cada uso, em ordem: se o primeiro falhar ou recusar, o próximo
# assume. Padrão: gemini:gemini-3.6-flash,anthropic:claude-opus-5-5.
# Veja o uso e o custo por modelo em Backoffice → IA.
IA_CORRECAO=
IA_CHAT=
IA_GERACAO=
# Esforço (raciocínio) da correção e da geração; cota de correções por mês
IA_EFFORT=low
IA_EFFORT_GERACAO=medium
IA_COTA_MENSAL=60
# Perguntas por dia no Chat IA
IA_CHAT_LIMITE_DIARIO=10
# Só para testes automatizados: aponta o Gemini para uma API falsa
# GEMINI_BASE_URL=

# Pagamentos (Asaas → Integrações → Chaves de API). ASAAS_AMBIENTE=producao para cobrar de verdade.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Token que você define ao cadastrar o webhook no Asaas (URL: https://SEU-SITE/api/asaas/webhook)
ASAAS_WEBHOOK_TOKEN=
# Endereço público do site (usado nos links de volta do checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preços dos planos: src/lib/planos.ts. ASAAS_API_URL só para testes automatizados
# (aponta para uma API falsa); em produção deixe vazio.

# Certificado (quem assina e o nome da plataforma no PDF)
CERTIFICADO_PLATAFORMA=OdontoLab
CERTIFICADO_RESPONSAVEL=Coordenação pedagógica
CERTIFICADO_RESPONSAVEL_CARGO=
